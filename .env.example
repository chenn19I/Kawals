# Hanya dibaca oleh apps/api dan spikes. Jangan pernah memberi awalan VITE_.
# Salin file ini menjadi .env.local lalu isi nilainya.
# .env.local diabaikan git dan tidak boleh ikut terkirim ke frontend.

TATUM_API_KEY=
TATUM_SUI_NETWORK=mainnet

# MEMWAL_OWNER adalah alamat dompet pemilik (boleh publik).
# MEMWAL_ACCOUNT_ID adalah objek MemWalAccount di Sui, bukan alamat dompet.
MEMWAL_OWNER=
MEMWAL_ACCOUNT_ID=
# MEMWAL_KEY adalah delegate PRIVATE key Ed25519 (64 hex). Rahasia.
# Jangan menaruh public key di sini; relayer akan menolak dengan 401.
MEMWAL_KEY=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=

# Opsional. Endpoint gRPC Tatum dan batas waktu satu panggilan.
# TATUM_GRPC_URL=sui-mainnet-grpc.gateway.tatum.io:443
# TATUM_TIMEOUT_MS=7000

# Opsional. Pisahkan origin dengan koma.
# KAWAL_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
