{
  "name": "kawal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "dev:api": "pnpm --filter @kawal/api dev",
    "dev:web": "pnpm --filter @kawal/web dev",
    "build:api": "esbuild api-src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js \"--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "build:web": "pnpm --filter @kawal/web build",
    "build": "pnpm build:api && pnpm build:web"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
